generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Arquitectura Multi-tenant: Entidad Sucursal
model Sucursal {
  id        String   @id @default(uuid())
  nombre    String
  ubicacion String?
  // Horario de atención: 7 entradas, una por día (0=domingo ... 6=sábado).
  // [{ dia, cerrado, abre: "HH:MM", cierra: "HH:MM" }, ...]
  // Se guarda como documento y no en tabla aparte porque siempre se lee y se
  // escribe completo, nunca se consulta por día en SQL, y el tótem necesita
  // replicarlo como una sola unidad para poder validar sin internet.
  horario   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios     Usuario[]
  productos    Producto[]
  recetas      Receta[]
  pedidos      Pedido[]
  insumos      Insumo[]
  movimientos  MovimientoInventario[]
  pedidosCompra PedidoCompra[]
  solicitudesInsumo SolicitudInsumo[]
}

// Usuarios (Cajeros, Cocineros, Administradores)
model Usuario {
  id         String   @id @default(uuid())
  sucursalId String?
  sucursal   Sucursal? @relation(fields: [sucursalId], references: [id])
  nombre     String
  correo     String   @unique
  contrasena String
  rol        String   @default("CAJERO")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pedidos    Pedido[]
}



// Productos Terminados (Ej: Combo 1/4 de Pollo)
model Producto {
  id            String   @id @default(uuid())
  sucursalId    String
  sucursal      Sucursal @relation(fields: [sucursalId], references: [id])
  nombre        String
  categoria     String   @default("General")
  descripcion   String?
  precio        Float
  imagen        String?  @db.LongText // Foto del plato (ruta /images/... o dato base64 subido)
  estaDisponible Boolean @default(true)
  agregadoManual Boolean @default(false) // true = plato creado desde el panel (se muestra además del menú fijo)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  receta        Receta?
  itemsPedido   ItemPedido[]

  // Aislamiento en la base de datos: otras tablas apuntan al plato con
  // (id, sucursalId), así MySQL rechaza enlaces entre sucursales distintas.
  @@unique([id, sucursalId])
}

// Recetas para el motor de inventarios
model Receta {
  id         String   @id @default(uuid())
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  productoId String   @unique
  producto   Producto @relation(fields: [productoId, sucursalId], references: [id, sucursalId])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  insumos    RecetaInsumo[]

  @@unique([productoId, sucursalId])
}

model Insumo {
  id          String   @id @default(uuid())
  sucursalId  String
  sucursal    Sucursal @relation(fields: [sucursalId], references: [id])
  nombre      String
  unidad      String   // unidad BASE en la que vive el stock: g, ml, unidad
  stockActual Float    @default(0)
  stockMinimo Float    @default(0)
  // Cómo se COMPRA (unidad boliviana del proveedor) y su equivalencia en la unidad
  // base. Ej. aceite: unidadPedido = "caja", factorConversion = 6000 (ml por caja).
  // Sirve para la calculadora del pedido de compra: 4 cajas × 6000 = 24.000 ml.
  // Son opcionales: si están vacíos, se carga directo en la unidad base.
  unidadPedido     String?
  factorConversion Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usadoEnRecetas RecetaInsumo[]
  movimientos    MovimientoInventario[]
  // Proveedores habilitados para reponer ESTE insumo (relación muchos-a-muchos
  // EXPLÍCITA, con tabla de enlace propia y clave primaria). Sirve de validación:
  // al reponer, el gerente solo puede elegir un proveedor que provee este insumo.
  proveedores    InsumoProveedor[]
  pedidosCompraItems PedidoCompraItem[]
  solicitudes    SolicitudInsumo[]

  // Aislamiento en la base de datos: movimientos y solicitudes apuntan al
  // insumo con (id, sucursalId), así MySQL rechaza enlaces entre sucursales.
  @@unique([id, sucursalId])
}

// Historial de movimientos de inventario (entradas y salidas)
model MovimientoInventario {
  id            String   @id @default(uuid())
  sucursalId    String
  sucursal      Sucursal @relation(fields: [sucursalId], references: [id])
  insumoId      String
  insumo        Insumo   @relation(fields: [insumoId, sucursalId], references: [id, sucursalId])
  tipo          String
  cantidad      Float
  stockAntes    Float
  stockDespues  Float
  pedidoId      String?
  motivo        String?
  // Solo en las entradas por compra: de qué proveedor vino y a qué costo.
  // El proveedor es una entidad pasiva (no usa el sistema): solo se lo referencia.
  proveedorId   String?
  proveedor     Proveedor? @relation(fields: [proveedorId], references: [id])
  costo         Float?
  createdAt     DateTime @default(now())
}

// Proveedores de insumos. Entidad PASIVA: no tiene cuenta ni interfaz propia.
// El admin mantiene el catálogo; el gerente lo referencia al reponer stock.
model Proveedor {
  id          String   @id @default(uuid())
  nombre      String
  contacto    String?
  telefono    String?
  rubro       String?   // qué suele proveer (pollos, verduras, aceite, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movimientos MovimientoInventario[]
  // Insumos concretos que este proveedor puede abastecer (ver Insumo.proveedores).
  insumos     InsumoProveedor[]
  pedidosCompra PedidoCompra[]
}

// Tabla de enlace EXPLÍCITA entre Insumo y Proveedor (relación muchos-a-muchos).
// Tiene clave primaria propia (id) porque la base de producción exige que toda
// tabla tenga una; la relación implícita de Prisma no la generaba y el motor la
// rechazaba (sql_require_primary_key).
model InsumoProveedor {
  id          String    @id @default(uuid())
  insumoId    String
  proveedorId String
  insumo      Insumo    @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@unique([insumoId, proveedorId])
  @@index([proveedorId])
}

// Solicitud de reposición que un GERENTE le hace al ADMIN para un insumo de su
// sucursal ("El Prado pide: Aceite"). El admin la ve y arma el pedido de compra.
// Es solo un aviso liviano; no mueve stock ni exige proveedor.
model SolicitudInsumo {
  id            String   @id @default(uuid())
  sucursalId    String
  sucursal      Sucursal @relation(fields: [sucursalId], references: [id])
  insumoId      String
  insumo        Insumo   @relation(fields: [insumoId, sucursalId], references: [id, sucursalId])
  estado        String   @default("PENDIENTE") // PENDIENTE | ATENDIDA
  solicitadoPor String?  // nombre del gerente que la pidió (informativo)
  createdAt     DateTime @default(now())

  @@index([sucursalId])
  @@index([insumoId])
}

// Pedido/orden de compra a un proveedor. Lo crea el ADMIN (con la cantidad, una
// sola vez) y lo confirma el GERENTE de la sucursal al recibir la mercadería:
// ahí el stock se suma solo y queda asentado en el kardex. Refleja el circuito
// real de compras del negocio (Gestión de compras).
model PedidoCompra {
  id           String   @id @default(uuid())
  sucursalId   String
  sucursal     Sucursal  @relation(fields: [sucursalId], references: [id])
  proveedorId  String
  proveedor    Proveedor @relation(fields: [proveedorId], references: [id])
  estado       String    @default("PENDIENTE") // PENDIENTE | RECIBIDO | CANCELADO
  nota         String?
  creadoPor    String?   // nombre/correo del admin que lo generó (informativo)
  recibidoEn   DateTime? // cuándo el gerente confirmó el ingreso
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items        PedidoCompraItem[]
}

model PedidoCompraItem {
  id             String   @id @default(uuid())
  pedidoCompraId String
  pedidoCompra   PedidoCompra @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)
  insumoId       String
  insumo         Insumo   @relation(fields: [insumoId], references: [id])
  cantidad       Float
  costo          Float?   // costo de esa línea (opcional), pasa al kardex al recibir
}

model RecetaInsumo {
  id         String   @id @default(uuid())
  recetaId   String
  receta     Receta   @relation(fields: [recetaId], references: [id])
  insumoId   String
  insumo     Insumo   @relation(fields: [insumoId], references: [id])
  cantidad   Float
}

// Pedidos y comandas KDS
model Pedido {
  id           String       @id @default(uuid())
  sucursalId   String
  sucursal     Sucursal     @relation(fields: [sucursalId], references: [id])
  montoTotal   Float
  estado       String       @default("PENDIENTE")
  origen       String       @default("POS") // Indica si viene de "TOTEM" o "POS"
  numeroPedido Int?         // Número de turno que ve el cliente y la cocina (se reinicia cada día por terminal)
  metodoPago   String?      // Método elegido por el cliente en el tótem: "efectivo" o "qr" (lo ve la caja)
  clienteRef   String?      @unique // Etiqueta única del cliente (idempotencia offline: evita duplicados al sincronizar)
  usuarioId    String?      // Para saber qué cajero lo tomó (opcional si es del Tótem)
  usuario      Usuario?     @relation(fields: [usuarioId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  items        ItemPedido[]
}

model ItemPedido {
  id         String   @id @default(uuid())
  pedidoId   String
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int      @default(1)
  precio     Float
  detalle    String?  // Ej: presa elegida ("Pecho y Ala") o "guarnición" (para el KDS)
}
