generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Arquitectura Multi-tenant: Entidad Sucursal
model Sucursal {
  id        String   @id @default(uuid())
  nombre    String
  ubicacion String?
  // Horario de atención: 7 entradas, una por día (0=domingo ... 6=sábado).
  // [{ dia, cerrado, abre: "HH:MM", cierra: "HH:MM" }, ...]
  // Se guarda como documento y no en tabla aparte porque siempre se lee y se
  // escribe completo, nunca se consulta por día en SQL, y el tótem necesita
  // replicarlo como una sola unidad para poder validar sin internet.
  horario   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios     Usuario[]
  productos    Producto[]
  recetas      Receta[]
  pedidos      Pedido[]
  insumos      Insumo[]
  movimientos  MovimientoInventario[]
}

// Usuarios (Cajeros, Cocineros, Administradores)
model Usuario {
  id         String   @id @default(uuid())
  sucursalId String?
  sucursal   Sucursal? @relation(fields: [sucursalId], references: [id])
  nombre     String
  correo     String   @unique
  contrasena String
  rol        String   @default("CAJERO")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pedidos    Pedido[]
}



// Productos Terminados (Ej: Combo 1/4 de Pollo)
model Producto {
  id            String   @id @default(uuid())
  sucursalId    String
  sucursal      Sucursal @relation(fields: [sucursalId], references: [id])
  nombre        String
  categoria     String   @default("General")
  descripcion   String?
  precio        Float
  imagen        String?  @db.LongText // Foto del plato (ruta /images/... o dato base64 subido)
  estaDisponible Boolean @default(true)
  agregadoManual Boolean @default(false) // true = plato creado desde el panel (se muestra además del menú fijo)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  receta        Receta?
  itemsPedido   ItemPedido[]
}

// Recetas para el motor de inventarios
model Receta {
  id         String   @id @default(uuid())
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  productoId String   @unique
  producto   Producto @relation(fields: [productoId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  insumos    RecetaInsumo[]
}

model Insumo {
  id          String   @id @default(uuid())
  sucursalId  String
  sucursal    Sucursal @relation(fields: [sucursalId], references: [id])
  nombre      String
  unidad      String   // kg, g, ml, unidad
  stockActual Float    @default(0)
  stockMinimo Float    @default(0) 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usadoEnRecetas RecetaInsumo[]
  movimientos    MovimientoInventario[]
}

// Historial de movimientos de inventario (entradas y salidas)
model MovimientoInventario {
  id            String   @id @default(uuid())
  sucursalId    String
  sucursal      Sucursal @relation(fields: [sucursalId], references: [id])
  insumoId      String
  insumo        Insumo   @relation(fields: [insumoId], references: [id])
  tipo          String   
  cantidad      Float    
  stockAntes    Float
  stockDespues  Float
  pedidoId      String?  
  motivo        String?
  createdAt     DateTime @default(now())
}

model RecetaInsumo {
  id         String   @id @default(uuid())
  recetaId   String
  receta     Receta   @relation(fields: [recetaId], references: [id])
  insumoId   String
  insumo     Insumo   @relation(fields: [insumoId], references: [id])
  cantidad   Float
}

// Pedidos y comandas KDS
model Pedido {
  id           String       @id @default(uuid())
  sucursalId   String
  sucursal     Sucursal     @relation(fields: [sucursalId], references: [id])
  montoTotal   Float
  estado       String       @default("PENDIENTE")
  origen       String       @default("POS") // Indica si viene de "TOTEM" o "POS"
  numeroPedido Int?         // Número de turno que ve el cliente y la cocina (se reinicia cada día por terminal)
  metodoPago   String?      // Método elegido por el cliente en el tótem: "efectivo" o "qr" (lo ve la caja)
  clienteRef   String?      @unique // Etiqueta única del cliente (idempotencia offline: evita duplicados al sincronizar)
  usuarioId    String?      // Para saber qué cajero lo tomó (opcional si es del Tótem)
  usuario      Usuario?     @relation(fields: [usuarioId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  items        ItemPedido[]
}

model ItemPedido {
  id         String   @id @default(uuid())
  pedidoId   String
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int      @default(1)
  precio     Float
  detalle    String?  // Ej: presa elegida ("Pecho y Ala") o "guarnición" (para el KDS)
}
